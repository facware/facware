---
import BaseLayout from '../../layouts/BaseLayout.astro';

const APP_URL = 'https://expense-tracking.facware.com';
const SITE_URL = 'https://facware.com';
---

<BaseLayout
  title="ExpenseTracking — Private, Offline-First Expense Tracking App | Facware"
  description="ExpenseTracking is a free, offline-first PWA to record income and expenses, plan budgets, track vehicle costs, and handle multi-currency accounts — no cloud account required."
  canonicalURL="https://facware.com/products/expense-tracking.html"
  ogDescription="A private, offline-first expense tracking app: record income and expenses, plan budgets, track vehicle fuel and maintenance, and handle multi-currency accounts — no cloud account required."
  ogImage="https://facware.com/assets/images/products/expense-tracking/og-image.jpg"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ExpenseTracking",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web, Android",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "url": "https://expense-tracking.facware.com",
      "description": "Private, offline-first expense tracking PWA for income and expenses, budgets, vehicle costs, and multi-currency accounts.",
      "publisher": { "@type": "Organization", "name": "Facware", "url": "https://facware.com" }
    }
  </script>

  <!-- Product top bar: cross-link back to the Facware main site -->
  <div class="et-topbar">
    <div class="container et-topbar-inner">
      <a href={SITE_URL} class="et-topbar-back" aria-label="Back to Facware main site">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Facware
      </a>
      <div class="et-topbar-brand">
        <span class="et-topbar-logo" aria-hidden="true">
          <i class="fas fa-coins"></i>
        </span>
        <span>ExpenseTracking</span>
        <span class="et-topbar-by">by Facware</span>
      </div>
      <a href={APP_URL} class="btn btn-primary et-topbar-cta">Open the app <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </div>
  </div>

  <!-- HERO -->
  <section class="et-hero" aria-labelledby="et-hero-heading">
    <div class="container et-hero-inner">
      <div class="et-hero-copy">
        <p class="et-hero-eyebrow">Your money, on your device.</p>
        <h1 id="et-hero-heading">ExpenseTracking</h1>
        <p class="et-hero-sub">A private, offline-first finance app to record income and expenses, plan budgets, handle multi-currency accounts, and track vehicle costs — no cloud account required.</p>
        <div class="et-hero-actions">
          <a href={APP_URL} class="btn btn-primary btn-lg">
            Open the app <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
          <a href="#et-video" class="btn btn-outline-white btn-lg">
            <i class="fas fa-play" aria-hidden="true"></i> Watch the demo
          </a>
        </div>
        <ul class="et-hero-badges" role="list" aria-label="Key highlights">
          <li>PWA</li>
          <li>Offline-first</li>
          <li>Free</li>
          <li>EN | ES</li>
        </ul>
      </div>

      <!-- CSS phone mockup (replace with real screenshot later) -->
      <div class="et-phone" role="img" aria-label="ExpenseTracking app preview">
        <div class="et-phone-notch"></div>
        <div class="et-phone-screen">
          <div class="et-mock-header">
            <span>Balance</span>
            <strong>$12,480.50</strong>
            <em>+$1,240 this month</em>
          </div>
          <div class="et-mock-row"><i class="fas fa-shopping-cart" aria-hidden="true"></i><span>Groceries</span><b>-$182.40</b></div>
          <div class="et-mock-row"><i class="fas fa-gas-pump" aria-hidden="true"></i><span>Fuel</span><b>-$40.00</b></div>
          <div class="et-mock-row"><i class="fas fa-briefcase" aria-hidden="true"></i><span>Payroll</span><b class="et-mock-income">+$2,400.00</b></div>
          <div class="et-mock-row et-mock-row-sm"><i class="fas fa-receipt" aria-hidden="true"></i><span>Utilities</span><b>-$96.30</b></div>
          <div class="et-mock-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section" aria-labelledby="et-features-heading">
    <div class="container">
      <header class="section-header text-center">
        <p class="section-eyebrow">Everything you need</p>
        <h2 id="et-features-heading">One app for the whole picture of your money</h2>
        <p class="section-desc">Track income and expenses, keep budgets honest, and understand where your money actually goes — all without giving your data to a third party.</p>
      </header>

      <div class="et-features">
        <article class="et-card">
          <div class="et-card-icon"><i class="fas fa-wallet" aria-hidden="true"></i></div>
          <h3 class="et-card-title">Record anything, fast</h3>
          <p class="et-card-text">Log income and expenses in seconds with automatic categorization. Everything stays on your device.</p>
        </article>
        <article class="et-card">
          <div class="et-card-icon"><i class="fas fa-bullseye" aria-hidden="true"></i></div>
          <h3 class="et-card-title">Budgets that work</h3>
          <p class="et-card-text">Set monthly limits per category and see at a glance where you're over or under.</p>
        </article>
        <article class="et-card">
          <div class="et-card-icon"><i class="fas fa-chart-pie" aria-hidden="true"></i></div>
          <h3 class="et-card-title">Reports &amp; insights</h3>
          <p class="et-card-text">Generate detailed reports that support smarter saving decisions.</p>
        </article>
        <article class="et-card">
          <div class="et-card-icon"><i class="fas fa-car" aria-hidden="true"></i></div>
          <h3 class="et-card-title">Vehicle tracking</h3>
          <p class="et-card-text">Log fuel fill-ups and maintenance to understand the true cost of driving.</p>
        </article>
        <article class="et-card">
          <div class="et-card-icon"><i class="fas fa-coins" aria-hidden="true"></i></div>
          <h3 class="et-card-title">Multi-currency</h3>
          <p class="et-card-text">Handle several currencies with auto-updated exchange rates, and keep working offline with cached rates.</p>
        </article>
        <article class="et-card">
          <div class="et-card-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></div>
          <h3 class="et-card-title">Privacy by design</h3>
          <p class="et-card-text">No backend, no database service. Your data lives in the device's IndexedDB; backups and exports only happen when you choose.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PRIVACY STRIP -->
  <section class="section et-privacy" aria-label="Privacy promise">
    <div class="container et-privacy-inner">
      <i class="fas fa-lock et-privacy-icon" aria-hidden="true"></i>
      <p>Your data never leaves your device. Export a JSON backup, PDF report, or CSV whenever you want.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--gray" aria-labelledby="et-guide-heading">
    <div class="container">
      <header class="section-header text-center">
        <p class="section-eyebrow">How it works</p>
        <h2 id="et-guide-heading">Up and running in minutes</h2>
        <p class="section-desc">No sign-up, no credit card, no company account. Follow these steps to start tracking.</p>
      </header>

      <ol class="et-steps">
        <li class="et-step">
          <span class="et-step-num">1</span>
          <h3 class="et-step-title">Install the app</h3>
          <p class="et-step-text">Open <a href={APP_URL}>expense-tracking.facware.com</a> on your phone or desktop and add it to your home screen (PWA). It works offline.</p>
        </li>
        <li class="et-step">
          <span class="et-step-num">2</span>
          <h3 class="et-step-title">Set up accounts &amp; currency</h3>
          <p class="et-step-text">Create accounts, choose your currency, and add your starting balance.</p>
        </li>
        <li class="et-step">
          <span class="et-step-num">3</span>
          <h3 class="et-step-title">Record transactions</h3>
          <p class="et-step-text">Log income and expenses; categories apply automatically and can be customized to match how you think about money.</p>
        </li>
        <li class="et-step">
          <span class="et-step-num">4</span>
          <h3 class="et-step-title">Plan with budgets</h3>
          <p class="et-step-text">Set monthly limits and watch your remaining balance update in real time.</p>
        </li>
        <li class="et-step">
          <span class="et-step-num">5</span>
          <h3 class="et-step-title">Log vehicle expenses</h3>
          <p class="et-step-text">Track fuel and maintenance to see your real cost per kilometer.</p>
        </li>
        <li class="et-step">
          <span class="et-step-num">6</span>
          <h3 class="et-step-title">Back up &amp; export</h3>
          <p class="et-step-text">Download a JSON, PDF, or CSV export anytime. No account needed.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- SCREENSHOT GALLERY -->
  <section class="section" aria-labelledby="et-gallery-heading">
    <div class="container">
      <header class="section-header text-center">
        <p class="section-eyebrow">See it in action</p>
        <h2 id="et-gallery-heading">Screenshots</h2>
        <p class="section-desc">Drop your app screenshots into <code>public/assets/images/products/expense-tracking/</code> using the filenames below.</p>
      </header>

      <div class="et-gallery">
        <figure class="et-shot et-shot-wide">
          <img src="/assets/images/products/expense-tracking/screenshot-dashboard.png" alt="ExpenseTracking dashboard overview" loading="lazy" onerror="this.style.display='none'">
          <figcaption class="et-shot-caption"><span>Dashboard overview</span><small>Screenshot slot: screenshot-dashboard.png</small></figcaption>
        </figure>
        <figure class="et-shot">
          <img src="/assets/images/products/expense-tracking/screenshot-transactions.png" alt="ExpenseTracking transaction log" loading="lazy" onerror="this.style.display='none'">
          <figcaption class="et-shot-caption"><span>Transaction log</span><small>screenshot-transactions.png</small></figcaption>
        </figure>
        <figure class="et-shot">
          <img src="/assets/images/products/expense-tracking/screenshot-budgets.png" alt="ExpenseTracking budgets" loading="lazy" onerror="this.style.display='none'">
          <figcaption class="et-shot-caption"><span>Budgets</span><small>screenshot-budgets.png</small></figcaption>
        </figure>
        <figure class="et-shot">
          <img src="/assets/images/products/expense-tracking/screenshot-vehicles.png" alt="ExpenseTracking vehicle costs" loading="lazy" onerror="this.style.display='none'">
          <figcaption class="et-shot-caption"><span>Vehicle costs</span><small>screenshot-vehicles.png</small></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- VIDEO DEMO -->
  <section class="section section--gray" id="et-video" aria-labelledby="et-video-heading">
    <div class="container">
      <header class="section-header text-center">
        <p class="section-eyebrow">Demo</p>
        <h2 id="et-video-heading">See how it works in under a minute</h2>
      </header>
      <div class="et-video">
        <!-- Replace this placeholder with your YouTube/Vimeo iframe or a <video> tag -->
        <div class="et-video-placeholder">
          <i class="fas fa-play et-video-icon" aria-hidden="true"></i>
          <p>Video demo slot<br><small>Add a YouTube/Vimeo embed or an .mp4 file here</small></p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section" aria-labelledby="et-testimonials-heading">
    <div class="container">
      <header class="section-header text-center">
        <p class="section-eyebrow">Reviews</p>
        <h2 id="et-testimonials-heading">What users say</h2>
      </header>

      <div class="et-testimonials">
        <article class="et-testimonial">
          <div class="et-stars" aria-label="5 out of 5 stars" role="img">
            <i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i>
          </div>
          <blockquote>I finally stopped guessing where my money goes. The reports give me the whole picture in a minute.</blockquote>
          <p class="et-testimonial-author">— Reviewer name, placeholder</p>
        </article>
        <article class="et-testimonial">
          <div class="et-stars" aria-label="5 out of 5 stars" role="img">
            <i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i>
          </div>
          <blockquote>Works offline, no cloud account, no subscription. Exactly what I was looking for.</blockquote>
          <p class="et-testimonial-author">— Reviewer name, placeholder</p>
        </article>
        <article class="et-testimonial">
          <div class="et-stars" aria-label="5 out of 5 stars" role="img">
            <i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i><i class="fas fa-star" aria-hidden="true"></i>
          </div>
          <blockquote>The fuel log alone paid for itself — I finally know my real cost per kilometer.</blockquote>
          <p class="et-testimonial-author">— Reviewer name, placeholder</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="section section--gray" aria-labelledby="et-roadmap-heading">
    <div class="container">
      <header class="section-header text-center">
        <p class="section-eyebrow">Roadmap</p>
        <h2 id="et-roadmap-heading">Where the app is going</h2>
        <p class="section-desc">Shipped today, and a few things we're building next.</p>
      </header>

      <div class="et-roadmap">
        <div class="et-phase">
          <h3 class="et-phase-title"><i class="fas fa-check-circle" aria-hidden="true"></i> Now</h3>
          <ul class="et-phase-list" role="list">
            <li>Offline-first PWA</li>
            <li>Automatic categorization</li>
            <li>Budgets</li>
            <li>Reports</li>
            <li>Vehicle fuel &amp; maintenance</li>
            <li>Multi-currency</li>
            <li>English &amp; Spanish</li>
            <li>JSON / PDF / CSV export</li>
          </ul>
        </div>
        <div class="et-phase">
          <h3 class="et-phase-title"><i class="fas fa-hourglass-half" aria-hidden="true"></i> Next</h3>
          <ul class="et-phase-list" role="list">
            <li>Android app (Capacitor)</li>
            <li>Google Drive / Dropbox sync</li>
            <li>Recurring transactions</li>
            <li>Bank statement import</li>
          </ul>
        </div>
        <div class="et-phase">
          <h3 class="et-phase-title"><i class="fas fa-rocket" aria-hidden="true"></i> Later</h3>
          <ul class="et-phase-list" role="list">
            <li>AI insights: spending patterns &amp; anomalies</li>
            <li>Optional cloud AI</li>
            <li>Multi-device sync</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="et-final" aria-labelledby="et-final-heading">
    <div class="container et-final-inner">
      <p class="et-hero-eyebrow">Free to use</p>
      <h2 id="et-final-heading">Try ExpenseTracking today</h2>
      <p>Open the app on any device, add it to your home screen, and start tracking in minutes. No account, no cost.</p>
      <div class="et-hero-actions">
        <a href={APP_URL} class="btn btn-primary btn-lg">
          Open the app <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a href={SITE_URL} class="btn btn-outline-white btn-lg">
          <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Facware
        </a>
      </div>
    </div>
  </section>

  <style is:inline>
    .et-topbar{background:#0f1230;border-bottom:1px solid rgba(255,255,255,.08)}
    .et-topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:14px}
    .et-topbar-back{color:#9fb3d9;text-decoration:none;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:8px;transition:color .2s}
    .et-topbar-back:hover{color:#fff}
    .et-topbar-brand{color:#fff;font-weight:700;font-size:15px;display:inline-flex;align-items:center;gap:8px}
    .et-topbar-logo{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#086AD8,#4f7cff);color:#fff;font-size:13px}
    .et-topbar-by{color:#7c8db8;font-weight:500;font-size:12px}
    .et-topbar-cta{padding:10px 18px;font-size:14px}
    @media(max-width:640px){
      .et-topbar-back span,.et-topbar-by{display:none}
      .et-topbar-cta{font-size:13px;padding:9px 14px}
    }

    .et-hero{background:#0f1230;color:#fff;padding:clamp(48px,8vw,96px) 0 clamp(72px,10vw,120px);position:relative;overflow:hidden}
    .et-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(600px 400px at 80% 0%,rgba(8,106,216,.35),transparent 60%),radial-gradient(500px 320px at 10% 100%,rgba(79,124,255,.22),transparent 60%)}
    .et-hero-inner{position:relative;display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center}
    .et-hero-eyebrow{color:#7bc4f8;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px}
    .et-hero h1{color:#fff;font-size:clamp(2.4rem,6vw,4rem);letter-spacing:-1px;margin-bottom:18px}
    .et-hero-sub{color:rgba(255,255,255,.78);font-size:1.1rem;line-height:1.7;max-width:540px;margin-bottom:32px}
    .et-hero-actions{display:flex;flex-wrap:wrap;gap:14px}
    .et-hero-badges{display:flex;flex-wrap:wrap;gap:10px;list-style:none;margin-top:30px;padding:0}
    .et-hero-badges li{font-size:12px;font-weight:600;color:#cfe0ff;border:1px solid rgba(127,160,255,.4);border-radius:999px;padding:6px 14px;background:rgba(8,106,216,.12)}
    .et-phone{width:min(280px,100%);margin:0 auto;background:#101225;border:10px solid #1d2140;border-radius:34px;box-shadow:0 30px 60px rgba(0,0,0,.45);position:relative}
    .et-phone-notch{position:absolute;top:6px;left:50%;transform:translateX(-50%);width:90px;height:16px;background:#0b0d1f;border-radius:0 0 12px 12px;z-index:2}
    .et-phone-screen{background:linear-gradient(180deg,#151a38,#0e1028);border-radius:24px;padding:34px 16px 18px;display:flex;flex-direction:column;gap:10px}
    .et-mock-header{background:linear-gradient(135deg,#086AD8,#4f7cff);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:2px}
    .et-mock-header span{font-size:11px;color:rgba(255,255,255,.8)}
    .et-mock-header strong{font-size:22px;color:#fff}
    .et-mock-header em{font-size:12px;color:#b7ffd4;font-style:normal}
    .et-mock-row{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:10px 12px;display:flex;align-items:center;gap:10px;font-size:12px;color:#dfe6ff}
    .et-mock-row i{color:#7bc4f8;font-size:13px;width:16px;text-align:center}
    .et-mock-row span{flex:1}
    .et-mock-row b{white-space:nowrap}
    .et-mock-income{color:#7dffb0}
    .et-mock-chart{display:flex;align-items:flex-end;gap:6px;height:56px;padding:12px 8px 0;background:rgba(255,255,255,.05);border-radius:12px}
    .et-mock-chart i{flex:1;border-radius:4px 4px 0 0;background:linear-gradient(180deg,#4f7cff,#1c4fd8)}
    .et-mock-chart i:nth-child(1){height:40%}
    .et-mock-chart i:nth-child(2){height:60%}
    .et-mock-chart i:nth-child(3){height:45%}
    .et-mock-chart i:nth-child(4){height:75%}
    .et-mock-chart i:nth-child(5){height:55%}
    .et-mock-chart i:nth-child(6){height:85%}
    .et-mock-chart i:nth-child(7){height:65%;background:linear-gradient(180deg,#7dffb0,#1fbd6e)}
    @media(max-width:900px){
      .et-hero-inner{grid-template-columns:1fr}
      .et-hero{padding-bottom:56px}
      .et-phone{width:220px}
    }

    .et-features{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    @media(max-width:992px){.et-features{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:600px){.et-features{grid-template-columns:1fr}}
    .et-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:28px;transition:box-shadow .22s,transform .22s}
    .et-card:hover{box-shadow:0 18px 40px rgba(26,26,46,.12);transform:translateY(-3px)}
    .et-card-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(8,106,216,.1);color:#086AD8;font-size:20px;margin-bottom:18px}
    .et-card-title{font-size:1.05rem;font-weight:700;color:#1a1a2e;margin-bottom:8px}
    .et-card-text{font-size:14.5px;line-height:1.7;color:#5a6580}

    .et-privacy{background:#fff}
    .et-privacy-inner{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;max-width:760px}
    .et-privacy-icon{color:#086AD8;font-size:22px}
    .et-privacy p{margin:0;font-size:15px;font-weight:600;color:#1a1a2e;text-align:center}
    @media(max-width:600px){.et-privacy-inner{flex-direction:column;gap:8px}}

    .et-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;list-style:none;padding:0}
    @media(max-width:992px){.et-steps{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:600px){.et-steps{grid-template-columns:1fr}}
    .et-step{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:26px}
    .et-step-num{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:#086AD8;color:#fff;font-weight:800;font-size:18px;margin-bottom:16px}
    .et-step-title{font-size:1rem;font-weight:700;color:#1a1a2e;margin-bottom:8px}
    .et-step-text{font-size:14.5px;line-height:1.7;color:#5a6580}
    .et-step-text a{color:#086AD8;text-decoration:none;font-weight:600}
    .et-step-text a:hover{text-decoration:underline}

    .et-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;grid-auto-rows:minmax(180px,auto)}
